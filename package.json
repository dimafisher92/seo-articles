{
  "name": "seo-articles",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "build": "pnpm --filter @seo/web build",
    "dev": "pnpm --filter @seo/web dev",
    "worker": "pnpm --filter @seo/worker dev",
    "db:generate": "pnpm --filter @seo/db generate",
    "db:push": "pnpm --filter @seo/db push",
    "db:studio": "pnpm --filter @seo/db studio",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  }
}
