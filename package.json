{
  "name": "seo-articles",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "configure": "tsx scripts/setup.ts",
    "setup": "tsx scripts/setup.ts",
    "build": "pnpm --filter @seo/web build",
    "dev": "pnpm --filter @seo/web dev",
    "worker": "pnpm --filter @seo/worker dev",
    "db:generate": "pnpm --filter @seo/db generate",
    "db:push": "pnpm --filter @seo/db push",
    "db:studio": "pnpm --filter @seo/db studio",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "smoke": "tsx scripts/smoke.ts",
    "magnific:probe": "tsx scripts/magnific-probe.ts",
    "searchatlas:probe": "tsx scripts/searchatlas-probe.ts"
  },
  "devDependencies": {
    "@seo/db": "workspace:*",
    "@seo/shared": "workspace:*",
    "@types/node": "^22.18.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}