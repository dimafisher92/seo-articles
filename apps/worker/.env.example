# ─── Shared ──────────────────────────────────────────────────────────────────
# Postgres. On Neon/Supabase use the POOLED connection string.
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# Shared secret the local worker presents on /api/worker/*.
# Generate with: openssl rand -hex 32
WORKER_SECRET=""

# ─── apps/web (Vercel) ───────────────────────────────────────────────────────
# Google OAuth. Callback: https://<your-app>/api/auth/callback/google
AUTH_SECRET=""            # openssl rand -base64 32
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Who may sign in. At least one must be set or every sign-in is refused.
ALLOWED_EMAIL_DOMAINS="youragency.com"
ALLOWED_EMAILS=""

# Local development only — bypasses auth entirely. Never set on Vercel.
# AUTH_DISABLED="true"

# Vercel Blob (image storage). Added automatically by the Vercel integration.
BLOB_READ_WRITE_TOKEN=""

# Protects /api/cron/reap. Vercel sends this automatically once set.
CRON_SECRET=""            # openssl rand -hex 32

# Notion client roster
NOTION_TOKEN=""
NOTION_CLIENTS_DATABASE_ID="483dbcc6-4b34-459e-be34-57c1f70383a6"

# ─── apps/worker (your machine) ──────────────────────────────────────────────
APP_URL="https://your-app.vercel.app"
WORKER_ID="laptop"

# Claude. Run `claude setup-token` to mint a long-lived subscription token —
# this bills the existing subscription rather than API credits.
CLAUDE_CODE_OAUTH_TOKEN=""
# Alternative: metered API billing. Set one or the other, not both.
# ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5"
CLAUDE_FAST_MODEL="claude-sonnet-5"

# SearchAtlas — keyword volume, difficulty, rankings, SERP.
# Key from Dashboard → API Settings.
SEARCHATLAS_API_KEY=""
SEARCHATLAS_BASE_URL="https://api.searchatlas.com"
# Override individual paths if your plan exposes them differently.
# SEARCHATLAS_PATH_METRICS="/v2/keywords/overview"
# SEARCHATLAS_PATH_RELATED="/v2/keywords/related"
# SEARCHATLAS_PATH_RANKED="/v2/domains/ranked-keywords"
# SEARCHATLAS_PATH_SERP="/v2/serp"

# Magnific — image generation.
# Default transport is its remote MCP server. There is no key to set: run
#   claude mcp add --transport http magnific https://mcp.magnific.com
# once and complete the browser sign-in. Generation then runs on your Magnific
# account's credits. The worker reuses that session.
MAGNIFIC_TRANSPORT="mcp"

# Which generation model to ask for (e.g. a Nano Banana or Seedream variant).
# Pinned rather than chosen per image, so cost stays predictable and a client's
# articles share one visual language. Leave blank to let Magnific decide.
MAGNIFIC_IMAGE_MODEL=""

# Fallback path — only needed with MAGNIFIC_TRANSPORT="rest". Useful where a
# one-time browser OAuth flow is impractical, e.g. a worker on a VPS.
MAGNIFIC_API_KEY=""
MAGNIFIC_BASE_URL="https://api.magnific.com"

POLL_INTERVAL_SECONDS="5"
HEARTBEAT_SECONDS="60"
LOG_LEVEL="info"
